# ==============================================================================
# RivalTrack — Environment Configuration Template
# Duplicate this file to .env and replace placeholders with your actual keys.
# DO NOT commit real secrets or production keys to version control.
# ==============================================================================

# Supabase Project URL (found in Supabase Dashboard > Settings > API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous / Publishable Key (safe for browser access with Row Level Security)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_publishable_key_here

# Price Collector Endpoint
# - For local development (bypasses browser CORS via Vite middleware):
VITE_EDGE_COLLECT_URL=/api/collect-prices
# - For Supabase Cloud Edge Function deployment:
# VITE_EDGE_COLLECT_URL=https://your-project-id.supabase.co/functions/v1/collect-prices

# (Optional) OpenAI API Key for AI Insight Synthesis
# Can also be entered dynamically in the application Settings view.
# VITE_OPENAI_API_KEY=your_openai_api_key_here
